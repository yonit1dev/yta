---
import { site } from "@/data/site";

const pathname = Astro.url.pathname;
const links = [
  { href: "/", label: "Work" },
  { href: "/blog", label: "Writing" },
];
---

<header class="site-header">
  <a class="wordmark" href="/" aria-label={`${site.name}, home`}>
    <span aria-hidden="true">{site.shortName}</span>
  </a>
  <nav aria-label="Primary navigation">
    <ul>
      {
        links.map(({ href, label }) => {
          const isActive = href === "/" ? pathname === "/" : pathname.startsWith(href);
          return (
            <li>
              <a href={href} aria-current={isActive ? "page" : undefined}>{label}</a>
            </li>
          );
        })
      }
      <li>
        <button
          class="theme-toggle"
          type="button"
          data-theme-toggle
          aria-label="Use light theme"
          aria-pressed="false"
          title="Use light theme"
          hidden
        >
          <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="12" r="3.25"></circle>
            <path d="M12 2.75v2M12 19.25v2M2.75 12h2M19.25 12h2M5.46 5.46l1.42 1.42M17.12 17.12l1.42 1.42M18.54 5.46l-1.42 1.42M6.88 17.12l-1.42 1.42"></path>
          </svg>
          <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M20.25 15.2A8.5 8.5 0 0 1 8.8 3.75a8.5 8.5 0 1 0 11.45 11.45Z"></path>
          </svg>
        </button>
      </li>
    </ul>
  </nav>
</header>
