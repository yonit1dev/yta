---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { roles, site } from "@/data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const recentPosts = posts.slice(0, 3);

const formatDate = (date: Date) => new Intl.DateTimeFormat("en", {
  year: "numeric",
  month: "short",
  day: "numeric",
  timeZone: "UTC",
}).format(date);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: site.name,
  url: site.url,
  jobTitle: site.title,
  sameAs: [site.social.github, site.social.linkedin, site.social.x],
  worksFor: roles.map((role) => ({
    "@type": "Organization",
    name: role.company,
  })),
  knowsAbout: ["Software architecture", "Education technology", "Financial technology", "Product design"],
};
---

<BaseLayout structuredData={personSchema}>
  <header class="intro" data-reveal="1">
    <div class="identity">
      <h1>{site.name}</h1>
      <p class="role">{site.title}</p>
    </div>
    <p class="lede">
      I build software at the intersection of technology and business, mostly in education and finance. I lead small engineering teams. I care about good architecture, but I care just as much about what sits on top of it: is it useful, is it usable, does it do the job someone opened it to do?
    </p>
  </header>

  <aside class="now" aria-label="What I am doing now" data-reveal="2">
    <span class="section-label">Now</span>
    <p>Leading engineering and building products across education and finance.</p>
  </aside>

  <section class="section recent-writing" aria-labelledby="writing-heading" data-reveal="2">
    <div class="section-heading">
      <h2 class="section-label" id="writing-heading">Recent writing</h2>
      <a class="text-link" href="/blog">All writing →</a>
    </div>
    {
      recentPosts.length > 0 ? (
        <div class="post-list">
          {recentPosts.map((post) => (
            <a class="post-row" href={`/blog/${post.id}`}>
              <div>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </div>
              <time datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
            </a>
          ))}
        </div>
      ) : (
        <p class="writing-note">New articles are coming soon.</p>
      )
    }
  </section>

  <section class="section" aria-labelledby="work-heading" data-reveal="2">
    <h2 class="section-label" id="work-heading">Work</h2>
    <div class="work-list">
      {
        roles.map((role) => (
          <article>
            <div class="role-heading">
              <h3>{role.company}</h3>
              <span class="period">{role.period}</span>
            </div>
            <p class="role-meta">{role.role} · {role.location}</p>
            <div class="products">
              {role.products.map((product) => (
                <div class="product">
                  <span class="product-name">{product.name}</span>
                  <p>{product.description}</p>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section section-rule approach" aria-labelledby="approach-heading" data-reveal="3">
    <h2 class="section-label" id="approach-heading">How I think about it</h2>
    <p>I care about products that are useful and usable. One without the other does not work.</p>
  </section>
</BaseLayout>
